{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "Enrollment": { "$ref": "#/definitions/Enrollment" }
  },
  "required": ["Enrollment"],
  "title": "Enrollment",
  "definitions": {
    "Enrollment": {
      "$id": "#/properties/Enrollment",
      "type": "object",
      "title": "The Enrollment Schema",
      "required": ["studentOsid", "academicYear", "courseName", "enrollmentDate", "enrollmentStatus"],
      "properties": {
        "studentOsid": { "type": "string", "title": "Student OSID" },
        "academicYear": { "type": "string", "title": "Academic Year" },
        "program": { "type": "string", "title": "Program" },
        "courseName": { "type": "string", "title": "Course Name" },
        "enrollmentDate": { "type": "string", "format": "date", "title": "Enrollment Date" },
        "enrollmentStatus": {
          "type": "string",
          "title": "Enrollment Status",
          "enum": ["ACTIVE", "COMPLETED", "DISCONTINUED", "TRANSFERRED"]
        },
        "completionDate": { "type": "string", "format": "date", "title": "Completion Date" },
        "completionStatus": {
          "type": "string",
          "title": "Completion Status",
          "enum": ["COMPLETED", "IN_PROGRESS", "DISCONTINUED", "FAILED"]
        },
        "percentage": {
          "type": "number",
          "title": "Percentage",
          "minimum": 0,
          "maximum": 100
        },
        "grade": { "type": "string", "title": "Grade" }
      }
    }
  },
  "_osConfig": {
    "privateFields": [],
    "internalFields": [],
    "signedFields": [],
    "indexFields": ["studentOsid", "academicYear"],
    "systemFields": [
      "_osCreatedAt", "_osUpdatedAt", "_osCreatedBy", "_osUpdatedBy",
      "_osAttestedData", "_osClaimId", "_osState"
    ],
    "ownedReferences": { "studentOsid": "Student" },
    "inviteRoles": ["anonymous"],
    "roles": ["anonymous"]
  }
}
